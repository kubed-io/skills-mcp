# .git is deliberately NOT ignored: setuptools_scm derives the version from it,
# and the build fails without it.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.github/
deploy/
kustomization.yaml
*.log

# Fetched inside the image by scripts/fetch_skills.py — a local copy in the
# build context would be stale and would bust the cache on every dev fetch.
/skills/
